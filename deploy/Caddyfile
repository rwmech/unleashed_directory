# ===========================================================================
#  µnleashed BBS directory: web front end
# ===========================================================================
#
# File:        deploy/Caddyfile
# Purpose:     TLS and routing for the directory. Caddy gets certificates on
#              its own; nothing here needs a cron job.
#
# THE ONE THING NOT TO CHANGE:
#
#   /announce must stay reachable over PLAIN HTTP with no redirect.
#
# A board is a microcontroller with no TLS stack and never will have one.
# Caddy's default behaviour is to redirect every http:// request to https://,
# and a board that gets a 308 reports it to its sysop as "refused". That
# single default would break every heartbeat on the network, silently, and
# the boards would have no way to tell you why. The http:// block below
# carves that one path out and sends everything else upstairs.
#
# Copyright 2026 - Robert Mech
# License:     GNU General Public License v2 or later
# SPDX-License-Identifier: GPL-2.0-or-later
# ===========================================================================
#
# THIS IS A REFERENCE COPY. deploy/setup.sh writes the live one at
# /etc/caddy/Caddyfile from the domains you hand it, and that is the
# source of truth. This file is here for anybody configuring a web
# server by hand, on a machine setup.sh will not run on. Keep the two
# in step: this one used to redirect .net and .org at .com, which is
# exactly the mistake the block below now warns about.

# --- plain HTTP: the heartbeat endpoint, and a push upstairs for people ----
http://unleashedbbs.com, http://www.unleashedbbs.com,
http://unleashedbbs.net, http://www.unleashedbbs.net,
http://unleashedbbs.org, http://www.unleashedbbs.org {

	@announce path /announce
	handle @announce {
		reverse_proxy 127.0.0.1:8080 {
			header_up X-Real-IP {remote_host}
		}
	}

	# A browser that arrives on port 80 gets sent to the secure site.
	handle {
		redir https://unleashedbbs.com{uri} permanent
	}
}

# --- the site itself: every domain is served, not redirected -----------------
# The server picks which of the three faces to show from the Host header, so a
# redirect here would collapse all three into the board list and take the
# manifesto and the data page off the air with nothing to explain why.
unleashedbbs.com, www.unleashedbbs.com,
unleashedbbs.net, www.unleashedbbs.net,
unleashedbbs.org, www.unleashedbbs.org {
	encode gzip
	reverse_proxy 127.0.0.1:8080 {
		# The address the caller came from. reverse_proxy appends it to
		# X-Forwarded-For by itself, and X-Real-IP is set here because Caddy
		# does not set that one on its own. The directory believes both only
		# on a connection from a trusted proxy, which is loopback, so a
		# stranger sending their own X-Forwarded-For is ignored.
		#
		# If these ever stop arriving, every board on the list collapses to
		# one address: one listing published, the rest queued for ever, and
		# every board told its public address is 127.0.0.1.
		header_up X-Real-IP {remote_host}
	}
	log {
		output file /var/log/caddy/directory.log
		format console
	}
}
