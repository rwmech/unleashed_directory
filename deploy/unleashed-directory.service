[Unit]
Description=unleashed BBS directory
Documentation=https://github.com/rwmech/unleashed_directory
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=directory
Group=directory
WorkingDirectory=/srv/unleashed_directory
ExecStart=/usr/bin/python3 /srv/unleashed_directory/server.py
Restart=always
RestartSec=3

# Settings live here, so the code needs no deployment-specific edits.
Environment=DIRECTORY_DB=/var/lib/unleashed-directory/directory.db
Environment=DIRECTORY_HOST=127.0.0.1
Environment=DIRECTORY_PORT=8080
# Quoted: systemd splits an unquoted Environment= value on spaces, which
# silently turned this into just "unleashed".
Environment="DIRECTORY_NAME=µnleashed BBS directory"
Environment=DIRECTORY_URL=https://unleashedbbs.net
# The project's own site (since the split, 2026-09-26): the footer names it,
# and a path this directory no longer serves (/install, /about, the
# old guide paths are the directory's own /docs) is sent there with a 301.
# Empty it for a directory of your own.
Environment=DIRECTORY_HOME_URL=https://unleashedbbs.com
# The guides (unleashed_documentation), installed here by setup.sh from
# the checkout named in /etc/unleashed-directory/docs.
Environment=DIRECTORY_DOCS_DIR=/srv/unleashed_directory/docs
# The header: the wordmark, the suffix after it and the menu (2.0.3).
# setup.sh installs the project's own for unleashedbbs.net; with no file
# the header is neutral, the directory's own name and pages.
Environment=DIRECTORY_HEADER=/etc/unleashed-directory/header.json
# The firmware releases the main site's installer offers, read, never
# written: the newest release lights the update arrow on a board that is
# behind, and opens the guides' "::: from" gates. On a box without the
# main site the folder is simply absent, and so are both.
Environment=DIRECTORY_FIRMWARE_DIR=/srv/unleashed_site/firmware
Environment=DIRECTORY_PENDING_HOURS=3
Environment=DIRECTORY_EXPIRE_DAYS=7
# Four, not the shipped one (2.0.17). Several of the project's own boards
# sit behind one home address, one port each as the go-public guide says to
# run them, and with one published listing per address the second and third
# are queued for ever: the published ones never consult this again, so the
# newcomer waits behind siblings that will not leave. Four is three boards
# and room for one that has lost its token and is listing itself again
# beside its own husk, which is what a reflash or a restore does. So it is
# three boards and one spare rather than a round number: a FOURTH board
# behind this address means five here, or the newcomer queues exactly as
# HQ did. Two things move with it: ADDRESS_PER_MINUTE below, and the row
# cap, which the code reads as PER_ADDRESS + SPARE_ROWS. It also decides
# how many husks of one board can be published rather than queued, which
# is what dedupe is now for (see CLAUDE.md).
Environment=DIRECTORY_PER_ADDRESS=4
# Pinned at the shipped default rather than left to it, because the
# arithmetic in the next comment adds it to PER_ADDRESS: left implicit, a
# change to the code this unit overrides would falsify a comment here.
Environment=DIRECTORY_SPARE_ROWS=3
# The rate limit (site 1.3.12). MIN_SECONDS is per board: its token, or
# its address and port when it has none, so two boards behind one home
# address each have their own clock. ADDRESS_PER_MINUTE is the abuse stop:
# announces from one address in a minute, whatever boards it posts as.
#
# It has to stay clear of what this address's own boards send. The address
# holds at most PER_ADDRESS + SPARE_ROWS = 4 + 3 rows, and MIN_SECONDS
# holds each of the seven to two counted posts inside the minute, so 14 is
# the real ceiling and 30 is about twice it.
#
# A post refused for going too often moves neither clock. One refused at
# the row cap ("too many listings from this address") has already been
# counted against the minute by the time it is refused, which is
# deliberate: uncounted, a flood against a full address would never meet
# this ceiling at all.
Environment=DIRECTORY_MIN_SECONDS=30
Environment=DIRECTORY_ADDRESS_PER_MINUTE=30
# Who may tell the server where a request came from. Caddy reaches it over
# loopback, so loopback is the whole list. X-Forwarded-For is a header any
# stranger can send, and it is believed only on a connection from one of
# these; from anywhere else the socket address is used and the header is
# not read at all. Widen this only if something else sits in front of
# Caddy, and name that thing here rather than trusting the header at large.
Environment=DIRECTORY_TRUSTED_PROXIES=127.0.0.1,::1

# It listens on loopback only and Caddy is the thing facing the internet, so
# it needs nothing else: no new privileges, no write access beyond its own
# database, no view of anybody's home directory.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/var/lib/unleashed-directory

[Install]
WantedBy=multi-user.target
